<Project DefaultTargets="Build">

  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>

    <!-- Enable roll-forward to latest patch.  This allows one restore operation
         to apply to all of the self-contained publish operations. -->
    <TargetLatestRuntimePatch>true</TargetLatestRuntimePatch>
  </PropertyGroup>

  <!-- Pass -p:SkipTests=true to skip publishing the test projects -->
  <Target Name="PublishAllRids" Condition="'$(SkipTests)' != 'true' Or '$(ReadarrOutputType)' != 'Test'">
    <!-- Single-targeted projects: only pass RuntimeIdentifier. Adding TargetFramework as a global property
         would create a second instance of each project (ProjectReferences build it without TargetFramework),
         and both instances would build in parallel into the same obj/output folders. -->
    <ItemGroup Condition="'$(TargetFrameworks)' == ''">
      <_PublishRid Include="$(RuntimeIdentifiers)" />
      <ProjectToPublish Include="@(_PublishRid->'$(MSBuildProjectFullPath)')">
        <AdditionalProperties>RuntimeIdentifier=%(_PublishRid.Identity)</AdditionalProperties>
      </ProjectToPublish>
    </ItemGroup>

    <!-- Multi-targeted projects: publish every RuntimeIdentifier/TargetFramework combination -->
    <ItemGroup Condition="'$(TargetFrameworks)' != ''">
      <Frameworks Include="$(TargetFrameworks)" />

      <Combined Include="$(RuntimeIdentifiers)">
        <Framework>%(Frameworks.Identity)</Framework>
      </Combined>

      <Renamed Include="@(Combined->'%(Identity):%(Framework)')">
        <Runtime>%(Identity)</Runtime>
        <Framework>%(Framework)</Framework>
      </Renamed>

      <ProjectToPublish Include="@(Renamed->'$(MSBuildProjectFullPath)')">
        <AdditionalProperties>RuntimeIdentifier=%(Renamed.Runtime);TargetFramework=%(Renamed.Framework)</AdditionalProperties>
      </ProjectToPublish>
    </ItemGroup>

    <MSBuild Projects="@(ProjectToPublish)"
             Targets="Publish"
             BuildInParallel="true"
             />
  </Target>

</Project>
